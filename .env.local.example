# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GestorPro

# CFDI / SAT — SW SapienS PAC (https://sw.com.mx)
# Store these in the org settings UI, not here — kept for local dev overrides
SW_SAPIENS_USERNAME=demo@email.com
SW_SAPIENS_PASSWORD=your-sw-password

# WhatsApp Business Cloud API (Meta)
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_TOKEN=your-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Conekta payments (https://developers.conekta.com)
CONEKTA_PRIVATE_KEY=key_xxxxxxxxxxxxxxxx
CONEKTA_WEBHOOK_SECRET=your-webhook-signing-secret
